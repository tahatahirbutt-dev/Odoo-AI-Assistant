      "name": "Fetch Products"
    },
    {
      "parameters": {
        "jsCode": "const products = $input.first().json.result || [];\n\nreturn products.map(product => {\n  // Use truthiness to handle Odoo's false, null, or empty string\n  const sku = product.default_code ? String(product.default_code) : '';\n  const category = (product.categ_id && product.categ_id[1]) ? product.categ_id[1] : 'Uncategorized';\n  \n  // Handle potential false values for numeric fields\n  const price = product.list_price ? Number(product.list_price) : 0;\n  const qty = product.qty_available ? Number(product.qty_available) : 0;\n\n  const pageContent = `Product: ${product.name} | Category: ${category} | SKU: ${sku}`;\n\n  return {\n    json: {\n      pageContent: pageContent,\n      metadata: {\n        odoo_id: product.id,\n        name: product.name,\n        default_code: sku,\n        list_price: price,\n        qty_available: qty,\n        category: category\n      }\n    }\n  };\n});"
      },
